# AI backend only. Put the rotated key in the backend server's .env file.
# Do not place a real key in Unity, a mobile build, or this sample file.
OPENAI_API_KEY=replace_with_a_new_rotated_key
OPENAI_MODEL=gpt-6-luna

# Keep the server local by default. For a phone on the same LAN, change
# QUIZ_HOST to 0.0.0.0 and set a long random token (at least 24 characters).
QUIZ_HOST=127.0.0.1
QUIZ_PORT=8787
QUIZ_ACCESS_TOKEN=
